<web-app version="3.0"
         xmlns="http://java.sun.com/xml/ns/javaee"
>

    <display-name>Recipes App</display-name>
    <listener>
        <listener-class>ch.lavanchy.recipes.config.GuiceContext</listener-class>
    </listener>
    <filter>
        <filter-name>GuiceFilter</filter-name>
        <filter-class>com.google.inject.servlet.GuiceFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>GuiceFilter</filter-name>
        <url-pattern>/backend/*</url-pattern>
    </filter-mapping>
