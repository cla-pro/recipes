<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://java.sun.com/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://java.sun.com/xml/ns/persistence http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd"
             version="2.0">
    <persistence-unit name="recipes-pu"
                      transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>ch.lavanchy.recipes.entities.CommentEntity</class>
        <class>ch.lavanchy.recipes.entities.RecipeEntity</class>
        <class>ch.lavanchy.recipes.entities.TagEntity</class>

        <properties>
            <property name="hibernate.connection.driver_class" value="${ch.lavanchy.recipes.db.driver_class}" />
            <property name="hibernate.connection.url" value="${ch.lavanchy.recipes.db.url}" />
            <property name="hibernate.connection.username" value="${ch.lavanchy.recipes.db.username}" />
            <property name="hibernate.connection.password" value="${ch.lavanchy.recipes.db.password}" />
            <property name="hibernate.connection.provider_class" value="org.hibernate.connection.C3P0ConnectionProvider" />
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect" />
            <property name="hibernate.id.new_generator_mappings" value="true" />
            <property name="hibernate.c3p0.idle_test_period" value="60" />
        </properties>
    </persistence-unit>
</persistence>